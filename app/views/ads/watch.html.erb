<% content_for :title, "Watch an ad — Ads" %>

<header class="topbar">
  <div class="topbar-left">
    <%= render "shared/nav_icons" %>
  </div>
</header>

<main class="dashboard-main">
  <section class="dashboard-hero">
    <h1><%= t("ads.watch.title") %></h1>

    <% if @servers.empty? %>
      <p class="lede"><%= t("ads.watch.no_servers") %></p>
      <%= link_to t("ads.watch.back_to_dashboard"), dashboard_path, class: "btn btn-ghost" %>
    <% elsif @server.nil? %>
      <p class="lede"><%= t("ads.watch.pick_server_lede") %></p>

      <%= form_with url: watch_ad_path, method: :get, local: true do %>
        <div class="field">
          <%= label_tag :server_id, t("ads.watch.server_label") %>
          <%= select_tag :server_id, options_from_collection_for_select(@servers, :id, :name), prompt: t("ads.watch.choose_server"), required: true %>
        </div>
        <%= submit_tag t("ads.watch.continue"), class: "btn btn-primary" %>
      <% end %>
    <% elsif adgate_configured? %>
      <p class="lede"><%= t("ads.watch.claim_for_html", server: @server.name) %></p>
      <p class="lede"><%= t("ads.watch.offers_lede") %></p>

      <%= link_to t("ads.watch.continue_to_offers"), ad_offers_path(server_id: @server.id), class: "btn btn-primary" %>
      <%= link_to t("ads.watch.pick_different_server"), watch_ad_path, class: "btn btn-ghost" %>
    <% elsif !simulated_claims_allowed? %>
      <p class="lede"><%= t("ads.watch.unavailable") %></p>
      <%= link_to t("ads.watch.back_to_dashboard"), dashboard_path, class: "btn btn-ghost" %>
    <% else %>
      <p class="lede"><%= t("ads.watch.claim_for_html", server: @server.name) %></p>

      <div class="ad-player" data-controller="ad-watch" data-ad-watch-duration-value="8"
           data-ad-watch-remaining-text-value="<%= t('ads.watch.timer_remaining', seconds: '%{seconds}') %>"
           data-ad-watch-finished-text-value="<%= t('ads.watch.ad_finished') %>">
        <div class="ad-progress-track">
          <div class="ad-progress-bar" data-ad-watch-target="progress"></div>
        </div>
        <p class="ad-timer" data-ad-watch-target="timer"><%= t("ads.watch.timer_remaining", seconds: 8) %></p>

        <%= form_with url: claim_ad_path, method: :post, local: true do %>
          <%= hidden_field_tag :server_id, @server.id %>
          <%= submit_tag t("ads.watch.claim_reward"), class: "btn btn-primary", disabled: true, data: { ad_watch_target: "claimButton" } %>
        <% end %>
      </div>

      <%= link_to t("ads.watch.pick_different_server"), watch_ad_path, class: "btn btn-ghost" %>
    <% end %>
  </section>
</main>
