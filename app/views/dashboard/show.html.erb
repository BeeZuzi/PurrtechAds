<% content_for :title, "Dashboard — Ads" %>

<header class="topbar">
  <div class="topbar-left">
    <%= render "shared/nav_icons" %>
    <%= render "shared/locale_switcher" %>
  </div>
  <div class="topbar-right">
    <%= button_to "Log out", session_path, method: :delete, class: "btn btn-ghost", form: { class: "logout-form" } %>
  </div>
</header>

<main class="dashboard-main">
  <section class="dashboard-hero">
    <h1><%= t("dashboard.welcome", nick: @user.minecraft_nick) %></h1>

    <% if current_user.can_approve_servers? %>
      <p class="lede"><%= t("dashboard.admin_lede") %></p>

      <div class="dashboard-choices">
        <% if current_user.can_manage_users? %>
          <%= link_to admin_users_path, class: "choice-card" do %>
            <span class="choice-icon"><%= icon_gear_svg.html_safe %></span>
            <h2><%= t("dashboard.manage_users_title") %></h2>
            <p><%= t("dashboard.manage_users_body") %></p>
          <% end %>
        <% end %>

        <%= link_to admin_servers_path, class: "choice-card" do %>
          <span class="choice-icon"><%= icon_server_svg.html_safe %></span>
          <h2><%= t("dashboard.servers_title") %></h2>
          <p><%= t("dashboard.servers_body") %></p>
        <% end %>

        <%= link_to admin_contract_requests_path, class: "choice-card" do %>
          <span class="choice-icon"><%= icon_play_svg.html_safe %></span>
          <h2><%= t("dashboard.contract_requests_title") %></h2>
          <p><%= t("dashboard.contract_requests_body") %></p>
        <% end %>

        <% if current_user.admin? || current_user.superadmin? %>
          <%= link_to admin_fraud_flags_path, class: "choice-card" do %>
            <span class="choice-icon"><%= icon_gear_svg.html_safe %></span>
            <h2><%= t("dashboard.fraud_flags_title") %></h2>
            <p><%= t("dashboard.fraud_flags_body") %></p>
          <% end %>
        <% end %>

        <% if current_user.superadmin? %>
          <%= link_to admin_payouts_path, class: "choice-card" do %>
            <span class="choice-icon"><%= icon_gear_svg.html_safe %></span>
            <h2><%= t("dashboard.payouts_title") %></h2>
            <p><%= t("dashboard.payouts_body") %></p>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="lede"><%= t("dashboard.player_lede") %></p>

      <div class="dashboard-choices">
        <%= link_to servers_path, class: "choice-card" do %>
          <span class="choice-icon"><%= icon_server_svg.html_safe %></span>
          <h2><%= t("dashboard.own_server_title") %></h2>
          <p><%= t("dashboard.own_server_body") %></p>
        <% end %>

        <%= link_to watch_ad_path, class: "choice-card" do %>
          <span class="choice-icon"><%= icon_play_svg.html_safe %></span>
          <h2><%= t("dashboard.watch_ad_title") %></h2>
          <p><%= t("dashboard.watch_ad_body") %></p>
        <% end %>
      </div>
    <% end %>
  </section>
</main>

<%= render "shared/settings_panel" %>
