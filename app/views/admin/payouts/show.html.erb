<div class="admin-main">
  <h1>Payout #<%= @payout.id %></h1>

  <div class="detail-card">
    <p><strong>Server:</strong> <%= @payout.server.name %></p>
    <p><strong>Amount:</strong> <%= Payout.format_cents(@payout.amount_cents, @payout.currency) %></p>
    <p><strong>Status:</strong> <span class="status-badge status-<%= @payout.status %>"><%= @payout.status %></span></p>
    <p><strong>Created:</strong> <%= @payout.created_at.strftime("%d.%m.%Y %H:%M") %></p>
    <% if @payout.paid_at %>
      <p><strong>Paid at:</strong> <%= @payout.paid_at.strftime("%d.%m.%Y %H:%M") %></p>
    <% end %>
  </div>

  <% if @payout.pending? %>
    <%= button_to "Mark as paid", mark_paid_admin_payout_path(@payout), method: :patch, class: "btn btn-primary" %>
  <% end %>

  <%= link_to "← Back to list", admin_payouts_path, class: "btn btn-ghost" %>
</div>
