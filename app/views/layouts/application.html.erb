<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? yield(:title) : "Ads — #{t("meta.tagline")}" %></title>
  <meta name="description" content="<%= t("meta.description") %>">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@700,500,400&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@300..700&display=swap" rel="stylesheet">

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= yield :head %>
  <%= javascript_importmap_tags %>
</head>
<body data-controller="theme">
  <% if notice %>
    <div class="flash"><div class="flash-message flash-notice"><%= notice %></div></div>
  <% end %>
  <% if alert %>
    <div class="flash"><div class="flash-message flash-alert"><%= alert %></div></div>
  <% end %>

  <%= yield %>
</body>
</html>