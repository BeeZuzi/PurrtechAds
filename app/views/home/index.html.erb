<% content_for :title, "Ads — Watch. Earn. Play." %>

<header class="topbar">
  <div class="topbar-left">
    <%= render "shared/locale_switcher" %>
  </div>
  <div class="topbar-right"></div>
</header>

<main>
  <section class="hero">
    <span class="hero-badge"><%= t("home.badge") %></span>
    <h1><%= t("home.hero_title") %> <em><%= t("home.hero_title_em") %></em> <%= t("home.hero_title_rest") %></h1>
    <p class="lede">
      <%= t("home.lede") %>
    </p>
    <div class="hero-actions">
      <%= link_to t("home.get_started"), "#auth", class: "btn btn-primary" %>
      <%= link_to t("home.how_it_works"), "#how-it-works", class: "btn btn-ghost" %>
    </div>
  </section>

  <div class="auth-wrap" id="auth" data-controller="theme">
    <div class="auth-card">
      <div class="auth-tabs" role="tablist" aria-label="Authentication mode">
        <button type="button"
                class="auth-tab"
                data-tab="login"
                data-theme-target="authTab"
                data-action="click->theme#switchAuthTab"
                role="tab" aria-selected="false"><%= t("home.auth.log_in_tab") %></button>

        <button type="button"
                class="auth-tab active"
                data-tab="signin"
                data-theme-target="authTab"
                data-action="click->theme#switchAuthTab"
                role="tab" aria-selected="true"><%= t("home.auth.sign_up_tab") %></button>
      </div>

      <%# LOGIN FORM %>
      <%= form_with url: session_path, method: :post, id: "login-form", local: true,
          class: "auth-form", data: { theme_target: "loginForm" } do |f| %>
        <div class="field">
          <%= f.label :email, t("home.auth.email") %>
          <%= f.email_field :email, placeholder: "you@example.com", autocomplete: "email", required: true %>
        </div>
        <div class="field">
          <%= f.label :password, t("home.auth.password") %>
          <%= f.password_field :password, placeholder: "••••••••", autocomplete: "current-password", required: true %>
        </div>
        <%= f.submit t("home.auth.log_in_submit"), class: "btn btn-primary auth-submit" %>
        <%= link_to t("home.auth.forgot_password"), new_password_reset_path, class: "auth-note" %>
      <% end %>

      <%# SIGNUP FORM %>
      <%= form_with model: (@user || User.new), url: users_path, method: :post, id: "signup-form", local: true,
          class: "auth-form active", data: { theme_target: "signupForm" } do |f| %>
        <% if (@user || User.new).errors.any? %>
          <ul class="auth-errors">
            <% (@user || User.new).errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        <% end %>
        <div class="field">
          <%= f.label :email, t("home.auth.email") %>
          <%= f.email_field :email, placeholder: "you@example.com", autocomplete: "email", required: true %>
        </div>
        <div class="field">
          <%= f.label :minecraft_nick, t("home.auth.minecraft_nick") %>
          <%= f.text_field :minecraft_nick, placeholder: "Steve123", autocomplete: "username", required: true %>
        </div>
        <div class="field">
          <%= f.label :password, t("home.auth.password") %>
          <%= f.password_field :password, placeholder: "••••••••", autocomplete: "new-password", required: true, minlength: 8 %>
        </div>
        <div class="field">
          <%= f.label :password_confirmation, t("home.auth.confirm_password") %>
          <%= f.password_field :password_confirmation, placeholder: "••••••••", autocomplete: "new-password", required: true %>
        </div>
        <%= f.submit t("home.auth.create_account"), class: "btn btn-primary auth-submit" %>
      <% end %>

      <p class="auth-note"><%= t("home.auth.terms_note") %></p>
    </div>
  </div>

  <section class="section" id="how-it-works">
    <h2 class="section-title"><%= t("home.how.title") %></h2>
    <p class="section-lede"><%= t("home.how.lede") %></p>

    <div class="feature-row">
      <article class="feature-card wide">
        <span class="feature-num">01</span>
        <h3><%= t("home.how.step1_title") %></h3>
        <p><%= t("home.how.step1_body") %></p>
      </article>
      <article class="feature-card">
        <span class="feature-num">02</span>
        <h3><%= t("home.how.step2_title") %></h3>
        <p><%= t("home.how.step2_body") %></p>
      </article>
      <article class="feature-card">
        <span class="feature-num">03</span>
        <h3><%= t("home.how.step3_title") %></h3>
        <p><%= t("home.how.step3_body") %></p>
      </article>
    </div>
  </section>
</main>

<%= render "shared/settings_panel" %>

<footer><%= t("home.footer_html", year: Date.current.year) %></footer>
