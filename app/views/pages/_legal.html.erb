<% content_for :title, "#{t("pages.#{page}.title")} — Ads" %>

<header class="topbar">
  <div class="topbar-left">
    <%= render "shared/locale_switcher" %>
  </div>
  <div class="topbar-right"></div>
</header>

<main class="section legal">
  <%= link_to t("pages.back_home"), root_path, class: "legal-back" %>
  <h1 class="section-title"><%= t("pages.#{page}.title") %></h1>

  <% t("pages.#{page}.sections").each do |section| %>
    <section class="legal-section">
      <h2><%= section[:heading] %></h2>
      <p><%= section[:body] %></p>
    </section>
  <% end %>
</main>

<%= render "shared/footer" %>
